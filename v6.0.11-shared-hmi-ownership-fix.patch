--- /dev/null
+++ b/packages/display/shared-hmi.yaml
@@ -0,0 +1,33 @@
+# ==============================================================================
+# SHARED V6 HMI INFRASTRUCTURE
+# ==============================================================================
+#
+# Composes target-neutral display infrastructure and persistent presentation
+# state used by the shared V6 HMI features.
+#
+# Dashboard and Rectifiers packages consume this common infrastructure without
+# owning or duplicating it.
+# ==============================================================================
+
+packages:
+
+  # ---------------------------------------------------------------------------
+  # DISPLAY INFRASTRUCTURE
+  # ---------------------------------------------------------------------------
+
+  display_hardware: !include hardware.yaml
+  display_theme: !include theme.yaml
+
+  # ---------------------------------------------------------------------------
+  # SHARED PRESENTATION STATE
+  # ---------------------------------------------------------------------------
+
+  display_ui_state: !include ui-state.yaml
+
+  # ---------------------------------------------------------------------------
+  # PERSISTENT HEADER
+  # ---------------------------------------------------------------------------
+
+  display_header_ui: !include header-ui.yaml
+  display_header: !include header.yaml
+  display_local_battery_header: !include local-battery-header.yaml
